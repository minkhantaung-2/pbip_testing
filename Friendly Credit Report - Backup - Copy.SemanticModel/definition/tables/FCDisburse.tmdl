	column 'Credit Range' = ```
			
			SWITCH(TRUE(),
			'FCDisburse'[principal]>=0 && 'FCDisburse'[principal]<=1000, "0 - 1000",
			'FCDisburse'[principal]>=1001 && 'FCDisburse'[principal]<=2000, "1001 - 2000",
			'FCDisburse'[principal]>=2001 && 'FCDisburse'[principal]<=3000, "2001 - 3000",

	measure 'YTD Profit LY' =
			CALCULATE(
			    [Total Profit],
			    DATESBETWEEN(
			        'Calendar'[cal_date],
			        EDATE(MIN('Calendar'[cal_date]),-12),
			        EOMONTH(MAX('Calendar'[cal_date]),-12)
			    ))
		formatString: 0
		lineageTag: 05d139e6-e932-42e6-82da-74ad34785031

